# Copy to /opt/hilobakestands/.env on the server and fill in.
DEBUG=0
SECRET_KEY=CHANGE-ME-generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=hilobakestands.com,www.hilobakestands.com
CSRF_TRUSTED_ORIGINS=https://hilobakestands.com,https://www.hilobakestands.com
DB_PATH=/opt/hilobakestands/data/db.sqlite3

# Email (Google Workspace legacy, app-specific password) — optional until needed
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Leave DEFAULT_FROM_EMAIL BLANK: the friendly "From" display name is set in
# config/settings.py (the value has spaces/angle-brackets that systemd's
# EnvironmentFile would mangle). Only override here with a BARE address if you
# must change the sender — and it must be a verified Gmail "send mail as" alias.
DEFAULT_FROM_EMAIL=

# OAuth — leave empty until owner login phase
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
