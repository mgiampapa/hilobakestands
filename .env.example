# Copy to /opt/hilobakestands/.env on the server and fill in.
DEBUG=0
SECRET_KEY=CHANGE-ME-generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=hilobakestands.com,www.hilobakestands.com
CSRF_TRUSTED_ORIGINS=https://hilobakestands.com,https://www.hilobakestands.com
DB_PATH=/opt/hilobakestands/data/db.sqlite3
MEDIA_ROOT=/opt/hilobakestands/media
# Public origin, no trailing slash. Used for claim links, sitemap, robots.txt,
# and (on the FIRST migrate) the django Site domain. Must not be blank.
SITE_BASE_URL=https://hilobakestands.com
# Where error/report/submission notification emails go. If unset, the code
# default (the original author's address) is used — anyone else MUST set this.
# ADMIN_EMAIL=you@example.com
# Privacy-preserving usage log (JSONL). Blank = disabled.
USAGE_LOG_PATH=/opt/hilobakestands/data/usage.jsonl

# Email (Google Workspace legacy, app-specific password) — optional until needed
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Leave DEFAULT_FROM_EMAIL BLANK: the friendly "From" display name is set in
# config/settings.py (the value has spaces/angle-brackets that systemd's
# EnvironmentFile would mangle). Only override here with a BARE address if you
# must change the sender — and it must be a verified Gmail "send mail as" alias.
DEFAULT_FROM_EMAIL=

# OAuth — leave empty until owner login phase
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple sign-in is wired up but unused (needs a paid Apple developer account).
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_B64=

# Cloudflare Turnstile (bot check on public forms). Blank = check skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Photo moderation (both optional). Blank = photos wait for manual review.
VISION_API_KEY=
MODERATION_FALLBACK_URL=
MODERATION_FALLBACK_TOKEN=
