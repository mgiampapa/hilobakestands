# Copy to .env on the homelab and fill in. monitor.py reads these via the env.
# (run.sh sources this file before launching the monitor.)

# --- where the files live on the media box ---
STANDS_JSON=/home/matt/social-monitor/stands_socials.json
STATE_DB=/home/matt/social-monitor/monitor_state.sqlite

# --- how the web server is reached for the scp pull (used by run.sh) ---
# Path is where export_socials.sh writes on Oracle: <BASE_DIR>/exports/.
ORACLE_SSH=ubuntu@hilobakestands.com
ORACLE_EXPORT_PATH=/opt/hilobakestands/app/exports/stands_socials.json

# --- signal tuning ---
LOOKBACK_DAYS=30
ERROR_THRESHOLD=3
MIN_DELAY=6
MAX_DELAY=18

# --- email digest (Gmail/Workspace app password, same pattern as the site) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=matt@giampapa.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DIGEST_FROM=Hilo Bake Stands Monitor <matt@hilobakestands.com>
DIGEST_TO=matt@giampapa.com
